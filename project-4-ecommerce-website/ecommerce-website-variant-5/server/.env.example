# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/ecommerce?retryWrites=true&w=majority

# Any long random string — used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional — only needed once you wire up real payments (see server/controllers/orderController.js)
STRIPE_SECRET_KEY=

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
